# Local showcase values only. Use a unique value and do not commit the resulting .env.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_MAX_CONNECTIONS=32
MAX_IN_FLIGHT_REQUESTS=512
RATE_LIMIT_PER_SECOND=2000
SESSION_RATE_LIMIT_PER_SECOND=100
STATUS_RATE_LIMIT_PER_SECOND=30
REQUEST_TIMEOUT_MS=3000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
VITE_SHOWCASE_BACKEND=enabled

# Application platform (optional; existing local experience remains available without these)
# Public keys only in VITE_* variables. Never put the service role key in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PLATFORM_API_URL=
VITE_ADMIN_HOST=admin.localhost
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=http://127.0.0.1:5173
ADMIN_APP_URL=http://admin.localhost:5173
PLATFORM_API_URL=http://127.0.0.1:3001
PLATFORM_PORT=3001
SANDBOX_AMOUNT_CENTS=100
RESEND_API_KEY=
EMAIL_FROM=

# Use default for Supabase built-in auth emails (link only); omit for custom link + OTP templates.
VITE_AUTH_EMAIL_TEMPLATE=

# Server only. Never prefix credentials with VITE_. Azure uses its v1 endpoint.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.5
AZURE_OPENAI_API_VERSION=v1
